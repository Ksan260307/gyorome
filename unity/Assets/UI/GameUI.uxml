<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="GameUI.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">
        <!-- 記号（♥ ★ ？）と、反応の名前（オノマトペ） -->
        <ui:VisualElement name="emotes" class="layer" picking-mode="Ignore" />
        <ui:VisualElement name="popups" class="layer" picking-mode="Ignore" />

        <!-- ===== HUD ===== -->
        <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
            <ui:VisualElement name="hud-top" class="hud-top" picking-mode="Ignore">
                <ui:Button name="book-button" class="hud-button">
                    <ui:VisualElement class="icon icon-book" picking-mode="Ignore" />
                    <ui:Label name="counter" text="0 / 100" class="counter" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="settings-button" class="hud-button hud-button--round">
                    <ui:VisualElement class="icon icon-gear" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <ui:Label name="toast" text="" class="toast hidden" picking-mode="Ignore" />
            <ui:Label name="hint" text="" class="hint hidden" picking-mode="Ignore" />
            <ui:Label name="title" text="ぎょろめ" class="title" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- ===== はんのう図鑑 ===== -->
        <ui:VisualElement name="book" class="overlay hidden">
            <ui:VisualElement name="book-panel" class="panel">
                <ui:VisualElement class="panel-header">
                    <ui:VisualElement class="panel-titles" picking-mode="Ignore">
                        <ui:Label text="はんのう図鑑" class="panel-title" picking-mode="Ignore" />
                        <ui:Label name="book-count" text="" class="panel-sub" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Button name="book-close" class="close-button">
                        <ui:VisualElement class="icon icon-close" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:ScrollView name="book-list" class="book-list" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ===== せってい ===== -->
        <ui:VisualElement name="settings" class="overlay hidden">
            <ui:VisualElement name="settings-panel" class="panel panel--small">
                <ui:VisualElement class="panel-header">
                    <ui:VisualElement class="panel-titles" picking-mode="Ignore">
                        <ui:Label text="せってい" class="panel-title" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Button name="settings-close" class="close-button">
                        <ui:VisualElement class="icon icon-close" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:ScrollView name="settings-list" class="settings-list">
                    <ui:Toggle name="toggle-sound" label="おと" class="setting-toggle" />
                    <ui:Toggle name="toggle-haptics" label="ふるえ（スマホ）" class="setting-toggle" />
                    <ui:Toggle name="toggle-names" label="はんのうの名前を出す" class="setting-toggle" />
                    <ui:Toggle name="toggle-hints" label="ヒントを出す" class="setting-toggle" />
                    <ui:Label text="目の色" class="setting-label" picking-mode="Ignore" />
                    <ui:VisualElement name="iris-swatches" class="swatches" />
                    <ui:Label text="まぶたの色" class="setting-label" picking-mode="Ignore" />
                    <ui:VisualElement name="lid-swatches" class="swatches" />
                    <ui:Button name="reset-button" text="図鑑をリセット" class="text-button text-button--danger" />
                    <ui:Label name="version" text="" class="version" picking-mode="Ignore" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
