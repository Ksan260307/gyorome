/* ぎょろめ UI — 目のじゃまをしない、最小限のもの。基準は 1080 x 1920 */

.root {
    flex-grow: 1;
    color: rgb(74, 58, 30);
    font-size: 34px;
}

.hidden {
    display: none;
}

.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-top {
    position: absolute;
    top: 24px;
    right: 24px;
    flex-direction: row;
    align-items: center;
}

.hud-button {
    flex-direction: row;
    align-items: center;
    height: 76px;
    padding: 0 26px;
    border-radius: 38px;
    border-width: 0;
    background-color: rgba(74, 58, 30, 0.35);
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.hud-button:hover {
    background-color: rgba(74, 58, 30, 0.55);
}

.hud-button:active {
    scale: 0.94 0.94;
}

.hud-button--round {
    width: 76px;
    padding: 0;
    justify-content: center;
}

.icon {
    width: 40px;
    height: 40px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.icon-gear { background-image: url("Icons/icon_gear.png"); }
.icon-close { background-image: url("Icons/icon_close.png"); width: 32px; height: 32px; }

/* ---- タイトル（はじめに少しだけ出る） ---- */
.title {
    position: absolute;
    left: 0;
    right: 0;
    top: 12%;
    -unity-text-align: middle-center;
    font-size: 140px;
    letter-spacing: 18px;
    color: rgba(74, 58, 30, 0.9);
    -unity-font-style: bold;
    transition-property: opacity, translate;
    transition-duration: 0.9s;
}

.title--hidden {
    opacity: 0;
    translate: 0 -40px;
}

/* ---- 記号 ---- */
.emote {
    position: absolute;
    font-size: 84px;
    -unity-font-style: bold;
    color: rgb(255, 120, 150);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(74, 58, 30, 0.6);
    -unity-text-align: middle-center;
    transform-origin: center;
}

.emote--pop { color: rgb(255, 120, 150); }
.emote--soft { color: rgba(120, 140, 200, 0.9); font-size: 64px; }
.emote--big { font-size: 130px; color: rgb(255, 90, 90); }
.emote--angry { color: rgb(220, 50, 50); font-size: 110px; }

/* ---- せってい ---- */
.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(40, 30, 20, 0.45);
    align-items: center;
    justify-content: center;
}

.panel {
    width: 90%;
    max-width: 900px;
    max-height: 84%;
    background-color: rgb(255, 250, 240);
    border-radius: 44px;
    padding: 28px 34px 34px 34px;
}

.panel-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
}

.panel-title {
    font-size: 48px;
    -unity-font-style: bold;
}

.close-button {
    width: 72px;
    height: 72px;
    border-radius: 36px;
    border-width: 0;
    background-color: rgba(74, 58, 30, 0.75);
    align-items: center;
    justify-content: center;
    padding: 0;
}

.close-button:active {
    scale: 0.92 0.92;
}

.setting-toggle {
    margin: 10px 0;
    font-size: 34px;
}

.setting-toggle .unity-toggle__label {
    min-width: 0;
    flex-grow: 1;
    font-size: 34px;
    color: rgb(74, 58, 30);
}

.setting-toggle .unity-toggle__checkmark {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border-width: 3px;
    border-color: rgb(74, 58, 30);
    background-color: rgb(255, 255, 255);
}

.setting-toggle:checked .unity-toggle__checkmark {
    background-color: rgb(255, 170, 40);
}

.setting-label {
    margin-top: 22px;
    margin-bottom: 8px;
    font-size: 30px;
    color: rgb(150, 120, 80);
}

.swatches {
    flex-direction: row;
    flex-wrap: wrap;
}

.swatch {
    width: 84px;
    height: 84px;
    border-radius: 42px;
    margin: 8px;
    border-width: 5px;
    border-color: rgba(74, 58, 30, 0.15);
    padding: 0;
}

.swatch:active {
    scale: 0.92 0.92;
}

.swatch--selected {
    border-color: rgb(74, 58, 30);
}

.version {
    margin-top: 18px;
    font-size: 22px;
    color: rgb(170, 150, 120);
    -unity-text-align: middle-center;
}
